generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  DRIVER
  MARKET
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(FARMER)
  fullName     String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farmer Farmer?
  driver Driver?
  market Market?
}

model Farmer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  farmName   String
  region     String
  district   String
  address    String?
  latitude   Float?
  longitude  Float?
  stir       String?  @unique
  isVerified Boolean  @default(false)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Driver {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleType   String
  plateNumber   String   @unique
  capacityKg    Decimal  @db.Decimal(12, 2)
  region        String
  licenseNumber String?
  shipments     Shipment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Market {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  stir        String? @unique
  region      String
  district    String
  address     String?

  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Booking {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  marketId  String
  market    Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)

  quantityKg Decimal       @db.Decimal(12, 2)
  pricePerKg Decimal       @db.Decimal(12, 2) // bron paytidagi narx
  status     BookingStatus @default(PENDING)
  message    String?
  decidedAt  DateTime?
  shipment   Shipment?
  payment    Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([marketId, status])
}

enum ProductStatus {
  ACTIVE
  BOOKED
  SOLD
  ARCHIVED
}

model Product {
  id       String @id @default(uuid())
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  name        String
  category    String
  quantityKg  Decimal       @db.Decimal(12, 2)
  pricePerKg  Decimal       @db.Decimal(12, 2)
  harvestDate DateTime?
  description String?
  status      ProductStatus @default(ACTIVE)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([status, category])
}

// Yuk tashish: fermer bronni tasdiqlaganda avtomatik yaratiladi
enum ShipmentStatus {
  OPEN       // haydovchi kutilmoqda
  LOADING    // yuklanmoqda (haydovchi biriktirilgan)
  IN_TRANSIT // yo'lda
  DELIVERED  // yetkazib berildi
  CANCELLED  // buyurtma bekor qilingan (to'lov qaytarilgan yoki to'lanmagan)
}

model Shipment {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  driverId  String?
  driver    Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  status ShipmentStatus @default(OPEN)

  // Bron paytidagi ma'lumotlar nusxasi: keyin profil o'zgarsa ham marshrut o'zgarmaydi
  cargoName       String
  category        String
  weightKg        Decimal @db.Decimal(12, 2)
  originRegion    String
  originDistrict  String
  originAddress   String?
  destRegion      String
  destDistrict    String
  destAddress     String?

  assignedAt  DateTime?
  deliveredAt DateTime?
  events      ShipmentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([driverId, status])
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  createdAt  DateTime       @default(now())

  @@index([shipmentId, createdAt])
}

// Kafolatlangan to'lov (escrow): bron tasdiqlanganda PENDING holatda yaratiladi.
// Xaridor to'laydi -> HELD (mablag' platformada muzlatilgan) -> yuk yetkazilgach RELEASED (fermerga) yoki REFUNDED (xaridorga).
enum PaymentStatus {
  PENDING   // to'lov kutilmoqda
  HELD      // mablag' escrow'da ushlab turilibdi
  RELEASED  // fermerga o'tkazib berilgan
  REFUNDED  // xaridorga qaytarilgan
  CANCELLED // to'lanmasdan bekor qilingan (pul harakati bo'lmagan)
}

model Payment {
  id          String        @id @default(uuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(20, 2) // server hisoblaydi: miqdor x bron narxi
  currency    String        @default("UZS")
  status      PaymentStatus @default(PENDING)
  provider    String
  providerRef String?
  heldAt      DateTime?
  releasedAt  DateTime?
  refundedAt  DateTime?
  events      PaymentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Tranzaksiyalar tarixi (audit): har bir holat o'zgarishi kim tomonidan va nima uchun qilingani bilan
model PaymentEvent {
  id        String        @id @default(uuid())
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status    PaymentStatus
  actor     String?       // MARKET | FARMER | ADMIN | SYSTEM
  note      String?
  createdAt DateTime      @default(now())

  @@index([paymentId, createdAt])
}

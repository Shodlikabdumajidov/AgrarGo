# ===== Majburiy =====
DATABASE_URL="postgresql://postgres:parol@localhost:5432/agrargo?schema=public"
# Production'da kamida 32 belgi, tasodifiy: openssl rand -base64 48
JWT_SECRET="uzun-tasodifiy-sir-almashtiring"

# ===== Ixtiyoriy (standart qiymatlari ko'rsatilgan) =====
NODE_ENV=development            # development | production | test
PORT=3000
JWT_EXPIRES_IN=7d               # 15m, 12h, 7d ...

# Frontend manzillari (vergul bilan, oxirida "/" siz). Production'da MAJBURIY va faqat https://
# Development'da bo'sh qoldirilsa hamma manzilga ruxsat beriladi.
CORS_ORIGINS=

# Nginx / balancer ortida nechta proksi borligi. Haqiqiy mijoz IP'si (rate-limit) uchun production'da 1 qo'ying.
# Proksisiz (to'g'ridan-to'g'ri internetga) 0 qoldiring, aks holda X-Forwarded-For soxtalashtirilishi mumkin.
TRUST_PROXY=0

# ===== Rate-limit chegaralari =====
THROTTLE_DEFAULT_LIMIT=120          # har bir IP, daqiqasiga (hamma marshrut)
THROTTLE_LOGIN_IP_LIMIT=20          # login urinishlari, 15 daqiqada, IP bo'yicha (limitdan keyin 15 daqiqa blok)
THROTTLE_LOGIN_PHONE_LIMIT=5        # login urinishlari, 15 daqiqada, telefon raqam bo'yicha (limitdan keyin 30 daqiqa blok)
THROTTLE_REGISTER_LIMIT=10          # barcha rollar uchun ro'yxatdan o'tish, soatiga, IP bo'yicha
THROTTLE_UPLOAD_LIMIT=10            # avatar yuklash, daqiqasiga
THROTTLE_BOOKING_LIMIT=30           # bron yaratish, daqiqasiga

# ===== To'lov (escrow) =====
# Hozircha faqat "simulated": haqiqiy pul harakati YO'Q. Production'da haqiqiy provayder (Payme/Click/Uzum) ulanmaguncha
# server ishga tushmaydi; faqat demo uchun ochiq ruxsat: PAYMENT_ALLOW_SIMULATION=true
PAYMENT_PROVIDER=simulated
PAYMENT_ALLOW_SIMULATION=false
# Yetkazilgandan keyin xaridor tasdiqlamasa, fermer pulni shuncha soatdan keyin o'zi chiqarib oladi
PAYMENT_RELEASE_GRACE_HOURS=72
# Omborxona buyurtmalari xizmat haqi, % (0-30)
WAREHOUSE_FEE_PERCENT=2
THROTTLE_PAYMENT_LIMIT=20           # to'lash/chiqarish/qaytarish, daqiqasiga (umumiy)

# ===== SMS va parolni tiklash =====
# Hozircha faqat "simulated": SMS YUBORILMAYDI (development'da kod javobda va jurnalda ko'rinadi). Production'da haqiqiy
# SMS provayder (Eskiz, Playmobile...) ulanmaguncha server ishga tushmaydi; faqat demo uchun SMS_ALLOW_SIMULATION=true
SMS_PROVIDER=simulated
SMS_ALLOW_SIMULATION=false
OTP_TTL_SECONDS=300                 # SMS kod amal qilish muddati (60..900)
OTP_MAX_ATTEMPTS=5                  # bitta kodni tekshirishga urinishlar (to'g'ri javob ham bitta urinish)
OTP_RESEND_COOLDOWN_SECONDS=60      # kodni qayta so'rash orasidagi kutish
RESET_TOKEN_TTL_SECONDS=600         # kod tasdiqlangach yangi parol o'rnatish uchun vaqt
THROTTLE_FORGOT_IP_LIMIT=5          # kod so'rash, soatiga, IP bo'yicha
THROTTLE_FORGOT_PHONE_LIMIT=3       # kod so'rash, soatiga, raqam bo'yicha (SMS "bombasi"dan himoya)
THROTTLE_VERIFY_IP_LIMIT=20         # kodni tekshirish, 15 daqiqada, IP bo'yicha
THROTTLE_VERIFY_PHONE_LIMIT=10      # kodni tekshirish, 15 daqiqada, raqam bo'yicha (keyin 30 daqiqa blok)
THROTTLE_RESET_LIMIT=10             # yangi parol o'rnatish, 15 daqiqada, IP bo'yicha
THROTTLE_CHANGE_PASSWORD_LIMIT=5    # parolni o'zgartirish, 15 daqiqada, foydalanuvchi bo'yicha (keyin 30 daqiqa blok)

# ===== GPS joylashuv (live tracking / ELD) =====
THROTTLE_LOCATION_LIMIT=12          # koordinata yuborish, minutiga, haydovchi bo'yicha (klient har 10-15 soniyada yuboradi)
# Demo (simulyatsiya) joylashuvi: development'da sukut bo'yicha yoqiq, production'da o'chiq.
# Yoqilsa haydovchi soxta nuqta yubora oladi (ko'ruvchilarga "Demo" deb ko'rsatiladi)
LOCATION_ALLOW_SIMULATION=false

# ===== Testlar uchun (faqat *_test bazasi: testlar jadvallarni tozalaydi) =====
# TEST_DATABASE_URL="postgresql://postgres:parol@localhost:5432/agrargo_test?schema=public"
